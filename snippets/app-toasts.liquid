<div 
  x-data="{
    toasts: [],
    addToast(message) {
      const id = Date.now().toString();
      this.toasts.push({ id, message });
      setTimeout(() => {
        this.toasts = this.toasts.filter(t => t.id !== id);
      }, 4000);
    }
  }"
  @show-toast.window="addToast($event.detail)"
  class="fixed bottom-5 right-5 z-55 flex flex-col gap-2.5 pointer-events-none max-w-sm w-full px-4"
>
  <template x-for="toast in toasts" :key="toast.id">
    <div 
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0 translate-y-2 scale-95"
      x-transition:enter-end="opacity-100 translate-y-0 scale-100"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 translate-y-2"
      class="pointer-events-auto bg-[#0a111a]/95 backdrop-blur border border-cyan-500/30 text-white rounded-xl shadow-lg shadow-cyan-950/20 p-4 flex items-center justify-between gap-3"
    >
      <div class="flex items-center gap-2.5">
        <div class="h-2 w-2 rounded-full bg-cyan-400 animate-ping"></div>
        <span class="text-xs font-semibold" x-text="toast.message"></span>
      </div>
      <button 
        @click="toasts = toasts.filter(t => t.id !== toast.id)"
        class="text-gray-500 hover:text-white transition-colors cursor-pointer text-xs font-mono"
      >
        Dismiss
      </button>
    </div>
  </template>
</div>
