{% comment %}
  Live order bookings simulated matching the exact React component with random names, locations, and real/mock items.
{% endcomment %}
<div 
  x-data="{
    notification: null,
    names: [
      'Zainab Bibi', 'Muhammad Ahmed', 'Usman Ali', 'Ayesha Malik', 
      'Hamza Khan', 'Fatima Sheikh', 'Bilal Siddiqui', 'Sana Yasmin', 
      'Hassan Raza', 'Omer Farooq', 'Saad Ghafoor', 'Mariam Jameel', 
      'Amina Butt', 'Usman Khalid', 'Sara Baig', 'Farhan Qureshi', 
      'Sidra Mughal', 'Zeeshan Akbar'
    ],
    cities: [
      'Lahore', 'Karachi', 'Islamabad', 'Rawalpindi', 'Faisalabad', 
      'Peshawar', 'Multan', 'Sialkot', 'Gujranwala', 'Quetta', 'Hyderabad'
    ],
    times: [
      'just now', '1 minute ago', '2 minutes ago', '45 seconds ago', '3 minutes ago'
    ],
    products: [
      { name: 'AirPods Pro 2 Master Copy', price: 'Rs. 2,499', emoji: '🎧' },
      { name: 'Y60 Ultra Smartwatch 7 in 1', price: 'Rs. 3,499', emoji: '⌚' },
      { name: 'M90 Pro Quad Gaming Earbuds', price: 'Rs. 1,899', emoji: '🎮' },
      { name: 'S10 Ultra 2 Max Smartwatch', price: 'Rs. 4,200', emoji: '⚙️' },
      { name: 'T900 Ultra Series 9 Smartwatch', price: 'Rs. 2,990', emoji: '🏁' }
    ],
    trigger() {
      const name = this.names[Math.floor(Math.random() * this.names.length)];
      const city = this.cities[Math.floor(Math.random() * this.cities.length)];
      const item = this.products[Math.floor(Math.random() * this.products.length)];
      const time = this.times[Math.floor(Math.random() * this.times.length)];
      
      this.notification = {
        name,
        city,
        itemName: item.name,
        price: item.price,
        emoji: item.emoji,
        time
      };

      // Auto-dismiss after 6.5 seconds
      setTimeout(() => {
        this.notification = null;
      }, 6500);
    },
    init() {
      // Warm welcome notification
      setTimeout(() => {
        this.trigger();
      }, 5000);

      // Repeat trigger every 22 seconds
      setInterval(() => {
        this.trigger();
      }, 22000);
    }
  }"
  class="fixed bottom-5 left-5 z-45 max-w-sm w-full px-4 sm:px-0 pointer-events-auto"
>
  <template x-if="notification">
    <div 
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 translate-y-8 scale-90"
      x-transition:enter-end="opacity-100 translate-y-0 scale-100"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100 scale-100"
      x-transition:leave-end="opacity-0 translate-y-4 scale-95"
      class="bg-[#090f19]/95 backdrop-blur border border-gray-800/80 p-4 rounded-2xl shadow-xl flex items-center gap-3.5 relative overflow-hidden"
    >
      <div class="absolute top-0 right-0 w-12 h-12 bg-[#00e5ff]/5 filter blur-xl rounded-full pointer-events-none"></div>

      <!-- Small Product Snapshot -->
      <div class="w-11 h-11 rounded-lg bg-slate-950 border border-gray-800/65 flex items-center justify-center flex-shrink-0 relative overflow-hidden text-xl select-none" x-text="notification.emoji">
        🎧
      </div>

      <!-- Live Notification Data -->
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-1.5 flex-wrap">
          <span class="text-white text-xs font-bold leading-none" x-text="notification.name">Usman Kahn</span>
          <span class="text-[#00e5ff] text-[9px] font-semibold uppercase tracking-wider bg-cyan-950/20 px-1 py-0.5 rounded" x-text="notification.city">LAHORE</span>
        </div>
        <p class="text-gray-400 text-[10px] mt-1 shrink truncate line-clamp-1">
          Ordered <strong class="text-gray-200" x-text="notification.itemName">AirPods Pro 2 Master Copy</strong>
        </p>
        <div class="flex items-center gap-2 mt-1">
          <span class="text-[10px] font-bold font-mono text-cyan-400" x-text="notification.price">
            Rs. 2,499
          </span>
          <span class="text-gray-600 text-[9px] font-mono select-none">&bull;</span>
          <span class="text-gray-500 text-[9px] font-mono select-none" x-text="notification.time">
            just now
          </span>
        </div>
      </div>

      <!-- COD indicator -->
      <div class="flex flex-col items-center justify-center gap-0.5 ml-1 select-none flex-shrink-0">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="text-emerald-400 text-[8px] font-mono font-bold uppercase mt-1">
          COD
        </span>
      </div>

    </div>
  </template>
</div>
