<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#080c10">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    <!-- Fonts Import -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700;800&family=Syne:wght@500;600;700;800&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ['Inter', 'sans-serif'],
              display: ['Syne', 'sans-serif'],
              mono: ['JetBrains Mono', 'monospace'],
            },
            colors: {
              brandBg: '#080c10',
              neonCyan: '#00e5ff',
              neonPurple: '#7c3aed',
            }
          }
        }
      }
    </script>

    <!-- Custom Global Head Styles -->
    <style>
      body {
        background-color: #080c10;
        color: #f3f4f6;
        font-family: 'Inter', sans-serif;
        overflow-x: hidden;
      }
      
      /* Webkit Custom Scrollbars to match React app */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #05090f;
      }
      ::-webkit-scrollbar-thumb {
        background: #121d2e;
        border-radius: 9999px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #00e5ff33;
      }

      /* Chrome, Safari, Edge, Opera number field spinner remover */
      input::-webkit-outer-spin-button,
      input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
      }

      /* Firefox */
      input[type=number] {
        -moz-appearance: textfield;
      }

      .text-glow-cyan {
        text-shadow: 0 0 10px rgba(0, 229, 255, 0.4);
      }
      .text-glow-purple {
        text-shadow: 0 0 10px rgba(124, 58, 237, 0.4);
      }
    </style>

    <!-- AlpineJS for Theme Reactivity & Drawers -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>
  </head>

  <body class="min-h-screen bg-brandBg text-gray-100 selection:bg-neonCyan/30 selection:text-white"
        x-data="{ 
          cartOpen: false, 
          cartCount: 0,
          toggleCart() { this.cartOpen = !this.cartOpen },
          triggerToast(msg) {
            const event = new CustomEvent('show-toast', { detail: msg });
            window.dispatchEvent(event);
          }
        }">
    
    <a class="sr-only" href="#MainContent">Skip to content</a>

    {% section 'header' %}

    <main id="MainContent" class="focus:outline-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <!-- Global Interactive Components and Ad triggers -->
    {% render 'promo-timer-ad' %}
    {% render 'live-order-notification' %}
    
    <!-- Client Toast Portal -->
    {% render 'app-toasts' %}

    <!-- Shopify default settings variable loader -->
    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };

      // Initialize Lucide icons
      document.addEventListener('DOMContentLoaded', () => {
        lucide.createIcons();
      });
    </script>
  </body>
</html>
