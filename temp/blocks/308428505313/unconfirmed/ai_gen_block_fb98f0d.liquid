{% doc %}
  @prompt
    Create a custom "Order with Cash on Delivery" button on the product page that adds the product to cart and redirects to checkout with Cash on Delivery (COD) payment method pre-noted in the order notes or redirects directly to checkout page. The button should be styled similar to the existing Add to Cart button and placed below or near it. Hide the default "Buy it Now" dynamic checkout button and replace it with this custom COD button.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cod-button-wrapper-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    margin-top: 16px;
  }

  .ai-cod-button-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: {{ block.settings.button_padding }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    gap: 8px;
  }

  .ai-cod-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-cod-button-{{ ai_gen_id }}:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .ai-cod-button-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .ai-cod-button-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .ai-cod-button-text-{{ ai_gen_id }} {
    flex-grow: 1;
    text-align: center;
  }

  .ai-cod-hide-dynamic-checkout-{{ ai_gen_id }} .shopify-payment-button {
    display: none !important;
  }
{% endstyle %}

<cod-button-{{ ai_gen_id }}
  class="ai-cod-button-wrapper-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
  data-product-id="{{ product.id }}"
>
  <button
    type="button"
    class="ai-cod-button-{{ ai_gen_id }}"
    data-cod-button
  >
    {% if block.settings.show_icon %}
      <span class="ai-cod-button-icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M21 18v1c0 1.1-.9 2-2 2H5c-1.11 0-2-.9-2-2V5c0-1.1.89-2 2-2h14c1.1 0 2 .9 2 2v1h-9c-1.11 0-2 .9-2 2v8c0 1.1.89 2 2 2h9zm-9-2h10V8H12v8zm4-2.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
        </svg>
      </span>
    {% endif %}
    <span class="ai-cod-button-text-{{ ai_gen_id }}">
      {{ block.settings.button_text }}
    </span>
  </button>
</cod-button-{{ ai_gen_id }}>

<script>
  (function() {
    class CodButton{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.button = this.querySelector('[data-cod-button]');
        this.productId = this.dataset.productId;
      }

      connectedCallback() {
        this.setupEventListeners();
        this.hideDynamicCheckout();
      }

      setupEventListeners() {
        if (this.button) {
          this.button.addEventListener('click', this.handleCodOrder.bind(this));
        }
      }

      hideDynamicCheckout() {
        const hideCheckout = {{ block.settings.hide_dynamic_checkout | json }};
        if (hideCheckout) {
          const productForm = document.querySelector('form[action*="/cart/add"]');
          if (productForm) {
            const formParent = productForm.closest('.product-form');
            if (formParent) {
              formParent.classList.add('ai-cod-hide-dynamic-checkout-{{ ai_gen_id }}');
            }
          }
        }
      }

      async handleCodOrder(event) {
        event.preventDefault();
        
        this.button.disabled = true;
        const originalText = this.button.querySelector('.ai-cod-button-text-{{ ai_gen_id }}').textContent;
        this.button.querySelector('.ai-cod-button-text-{{ ai_gen_id }}').textContent = '{{ block.settings.loading_text }}';

        try {
          const variantId = this.getSelectedVariantId();
          const quantity = this.getQuantity();

          if (!variantId) {
            alert('Please select a product variant');
            this.resetButton(originalText);
            return;
          }

          const formData = {
            items: [{
              id: variantId,
              quantity: quantity,
              properties: {
                '_payment_method': 'Cash on Delivery'
              }
            }]
          };

          const response = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(formData)
          });

          if (response.ok) {
            const addNoteToCart = {{ block.settings.add_note_to_cart | json }};
            
            if (addNoteToCart) {
              await this.updateCartNote();
            }

            const redirectToCheckout = {{ block.settings.redirect_to_checkout | json }};
            
            if (redirectToCheckout) {
              window.location.href = '/checkout';
            } else {
              window.location.href = '/cart';
            }
          } else {
            throw new Error('Failed to add to cart');
          }
        } catch (error) {
          console.error('Error:', error);
          alert('Failed to process order. Please try again.');
          this.resetButton(originalText);
        }
      }

      async updateCartNote() {
        try {
          const noteText = '{{ block.settings.cart_note_text }}';
          await fetch('/cart/update.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              note: noteText
            })
          });
        } catch (error) {
          console.error('Failed to update cart note:', error);
        }
      }

      getSelectedVariantId() {
        const productForm = document.querySelector('form[action*="/cart/add"]');
        if (!productForm) return null;

        const variantInput = productForm.querySelector('[name="id"]');
        return variantInput ? variantInput.value : null;
      }

      getQuantity() {
        const productForm = document.querySelector('form[action*="/cart/add"]');
        if (!productForm) return 1;

        const quantityInput = productForm.querySelector('[name="quantity"]');
        return quantityInput ? parseInt(quantityInput.value) || 1 : 1;
      }

      resetButton(originalText) {
        this.button.disabled = false;
        this.button.querySelector('.ai-cod-button-text-{{ ai_gen_id }}').textContent = originalText;
      }
    }

    customElements.define('cod-button-{{ ai_gen_id }}', CodButton{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "COD order button",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Button text"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Order with Cash on Delivery"
    },
    {
      "type": "text",
      "id": "loading_text",
      "label": "Loading text",
      "default": "Processing..."
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show cash icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Background color",
      "default": "#2c6ecb"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Border color",
      "default": "#2c6ecb"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Hover background color",
      "default": "#1e4d8b"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Hover text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_border_color",
      "label": "Hover border color",
      "default": "#1e4d8b"
    },
    {
      "type": "range",
      "id": "button_padding",
      "label": "Padding",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "Border width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "button_font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "checkbox",
      "id": "redirect_to_checkout",
      "label": "Redirect to checkout",
      "info": "If enabled, redirects to checkout page. If disabled, redirects to cart page.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "add_note_to_cart",
      "label": "Add note to cart",
      "info": "Adds a note to the cart indicating COD payment method",
      "default": true
    },
    {
      "type": "text",
      "id": "cart_note_text",
      "label": "Cart note text",
      "default": "Payment Method: Cash on Delivery (COD)"
    },
    {
      "type": "checkbox",
      "id": "hide_dynamic_checkout",
      "label": "Hide dynamic checkout buttons",
      "info": "Hides the default Buy it Now button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "COD order button"
    }
  ]
}
{% endschema %}
