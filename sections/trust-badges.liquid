<section id="trust-badges" class="bg-[#05090f]/60 border-t border-b border-gray-900 py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-[#00e5ff] text-xs font-mono font-bold tracking-widest uppercase">
        100% SECURE PAKISTAN DISPATCH
      </span>
      <h3 class="font-display font-black text-2xl sm:text-3xl text-white mt-2 uppercase">
        Ghabrana Nahi Hai! Assured COD
      </h3>
      <p class="text-gray-400 text-xs md:text-sm mt-2">
        We understand shopping custom copies online can be tricky. That's why we eliminate all risks!
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Card 1 -->
      <div class="bg-[#080d15] border border-gray-850 p-6 md:p-8 rounded-2xl relative overflow-hidden group">
        <div class="absolute top-0 right-0 w-32 h-32 bg-[#00e5ff]/5 filter blur-2xl rounded-full"></div>
        <div class="inline-flex p-3 bg-cyan-950/40 text-[#00e5ff] rounded-xl mb-5">
          <i data-lucide="banknote" class="w-6 h-6"></i>
        </div>
        <h4 class="text-white font-bold text-lg mb-2">Zero Advance Payments</h4>
        <p class="text-gray-400 text-xs md:text-[13px] leading-relaxed">
          Poore Pakistan mein sirf Cash on Delivery deal hoti hai. Pehle parcel check karein, phir delivery rider ko paise ada karein!
        </p>
      </div>

      <!-- Card 2 -->
      <div class="bg-[#080d15] border border-gray-850 p-6 md:p-8 rounded-2xl relative overflow-hidden group">
        <div class="absolute top-0 right-0 w-32 h-32 bg-[#7c3aed]/5 filter blur-2xl rounded-full"></div>
        <div class="inline-flex p-3 bg-violet-950/40 text-violet-400 rounded-xl mb-5">
          <i data-lucide="shield-check" class="w-6 h-6"></i>
        </div>
        <h4 class="text-white font-bold text-lg mb-2">7-Days Replacement Guarantee</h4>
        <p class="text-gray-400 text-xs md:text-[13px] leading-relaxed">
          Agar device mein koi kharabi ya packing fault aye, to bina kisi ghabrahat ke hum se replacement hasil karein!
        </p>
      </div>

      <!-- Card 3 -->
      <div class="bg-[#080d15] border border-gray-850 p-6 md:p-8 rounded-2xl relative overflow-hidden group">
        <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-550/5 filter blur-2xl rounded-full"></div>
        <div class="inline-flex p-3 bg-emerald-950/40 text-emerald-450 rounded-xl mb-5">
          <i data-lucide="thumbs-up" class="w-6 h-6"></i>
        </div>
        <h4 class="text-white font-bold text-lg mb-2">Double Checked Sealing Quality</h4>
        <p class="text-gray-400 text-xs md:text-[13px] leading-relaxed">
          Hamare warehouse checking staff har article ko dispatch se pehle sound quality, connectivity aur chargers verify krta hai.
        </p>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "TechZone Trust Badges",
  "settings": [],
  "presets": [
    {
      "name": "TechZone Trust Badges"
    }
  ]
}
{% endschema %}
