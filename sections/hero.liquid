<section class="relative overflow-hidden py-16 md:py-28 px-4 md:px-8 select-none">
  <!-- Glowing Gradients in background -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[350px] md:w-[600px] h-[350px] md:h-[600px] rounded-full bg-gradient-to-tr from-[#7c3aed]/10 to-[#00e5ff]/10 filter blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 right-10 w-96 h-96 rounded-full bg-[#00e5ff]/5 filter blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto flex flex-col items-center justify-center text-center relative z-10">
    <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/5 border border-gray-800/80 mb-5 text-[10px] sm:text-xs font-mono font-medium text-gray-300">
      <span class="w-1.5 h-1.5 bg-cyan-400 rounded-full animate-ping"></span>
      EID UL ADHA FESTIVAL BUMPER DISCOUNT DISPATCHING ACTIVE
    </div>

    <h1 class="font-display font-black text-4xl sm:text-5.5xl md:text-7.5xl text-white tracking-tight leading-none uppercase max-w-5xl">
      PREMIUM IMPORTS AT <br />
      <span class="bg-gradient-to-r from-neonCyan via-teal-400 to-neonPurple bg-clip-text text-transparent hover:brightness-110 transition-all text-glow-cyan">
        WHOLESALE PRICING
      </span>
    </h1>

    <p class="text-gray-400 text-sm md:text-base max-w-2xl mt-5 leading-relaxed font-sans">
      We source premium imports direct from manufacturers to offer you AirPods copies, Smartwatches, and action gaming drops at absolute factory prices. Under custom cash on delivery!
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3.5 mt-8">
      <a
        href="#products-section"
        class="bg-gradient-to-r from-neonCyan to-neonPurple hover:brightness-110 text-white font-display font-black text-xs md:text-sm py-4 px-7 rounded-xl transition-all shadow-lg active:scale-98"
      >
        Loot Sasta Tech Bazaar (Show Catalog)
      </a>
      
      <a
        href="#trust-badges"
        class="bg-[#0c1421] hover:bg-[#121d2e] border border-gray-800 hover:border-gray-600 text-gray-200 font-display font-bold text-xs md:text-sm py-4 px-7 rounded-xl transition-all hover:scale-101 active:scale-98 flex items-center gap-2"
      >
        COD Replacement Policy
        <i data-lucide="arrow-right" class="w-4 h-4 text-neonCyan"></i>
      </a>
    </div>

    <!-- Mini stats bar -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 px-6 py-4.5 bg-[#05090f]/75 border border-gray-800/60 rounded-2xl max-w-4xl w-full mt-14 md:mt-20">
      <div class="flex flex-col items-center">
        <span class="text-white font-mono font-black text-lg md:text-xl text-glow-cyan">4.8 ★</span>
        <span class="text-[10px] text-gray-500 uppercase mt-1">Store Rating</span>
      </div>
      <div class="border-r border-gray-800 md:block hidden"></div>
      <div class="flex flex-col items-center">
        <span class="text-white font-mono font-black text-lg md:text-xl text-glow-purple">12,000+</span>
        <span class="text-[10px] text-gray-500 uppercase mt-1">Orders Delivered</span>
      </div>
      <div class="border-r border-gray-800 md:block hidden"></div>
      <div class="flex flex-col items-center col-span-2 md:col-span-1">
        <span class="text-[#00ffbb] font-sans font-black text-xs md:text-[13px] uppercase flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-[#00ffbb] animate-pulse"></span>
          ACTIVE FAST
        </span>
        <span class="text-[10px] text-gray-500 uppercase mt-1">Same Day dispatch</span>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "TechZone Hero",
  "settings": [],
  "presets": [
    {
      "name": "TechZone Hero"
    }
  ]
}
{% endschema %}
