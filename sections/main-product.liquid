<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8" id="product-page-root">
  <!-- Back navigation banner -->
  <div class="mb-6 flex items-center justify-between">
    <a
      href="/"
      class="inline-flex items-center gap-2 px-4 py-2.5 bg-[#0d1522] border border-gray-800 hover:border-cyan-400/50 rounded-xl text-gray-300 hover:text-white transition-all text-xs font-semibold shadow-sm group"
    >
      <i data-lucide="arrow-left" class="w-4 h-4 text-[#00e5ff] transition-transform group-hover:-translate-x-1"></i>
      Kuch aur dekhein (Back to Catalog)
    </a>
    <span class="text-xs font-mono text-gray-500 bg-[#05090f] px-3.5 py-1.5 border border-gray-800/40 rounded-lg">
      Category: <span class="text-gray-300 uppercase font-semibold">{{ product.type | default: 'Premium Accessories' }}</span>
    </span>
  </div>

  <!-- Main product wrapper layout -->
  <div 
    x-data="{
      activeImage: 0,
      images: [
        {%- if product.images.size > 0 -%}
          {%- for img in product.images -%}
            '{{ img | image_url: width: 600 }}'{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        {%- else -%}
          'https://images.unsplash.com/photo-1600294037681-c80b4cb5b434?auto=format&fit=crop&q=80&w=800'
        {%- endif -%}
      ],
      reviews: [
        { id: 1, name: 'Usman Ali', city: 'Lahore', rating: 5, date: '2026-06-02', text: 'Bhai sound quality aur heavy bass bilkul original jesi hai. Shuru me lag raha tha master copy local hogi lekin battery backup kamaal hai!' },
        { id: 2, name: 'Sarah Khan', city: 'Karachi', rating: 5, date: '2026-06-01', text: 'Highly recommended! Box was properly sealed when delivered. Fast cash on delivery.' },
        { id: 3, name: 'Muhammad Bilal', city: 'Islamabad', rating: 4, date: '2026-05-28', text: 'Packaging is solid. ANC does fine job filtering background noise.' }
      ],
      newReviewName: '',
      newReviewCity: 'Lahore',
      newReviewRating: 5,
      newReviewText: '',
      reviewSuccess: false,
      reviewError: '',
      submitReview() {
        if (!this.newReviewName.trim()) {
          this.reviewError = 'Apna naam darj karein (Name is required).';
          return;
        }
        if (!this.newReviewText.trim() || this.newReviewText.trim().length < 8) {
          this.reviewError = 'Review thoda lamba likhein (Write something helpful).';
          return;
        }
        
        // Add review
        this.reviews.unshift({
          id: Date.now(),
          name: this.newReviewName.trim(),
          city: this.newReviewCity,
          rating: parseInt(this.newReviewRating),
          date: new Date().toISOString().split('T')[0],
          text: this.newReviewText.trim()
        });

        this.newReviewName = '';
        this.newReviewText = '';
        this.newReviewRating = 5;
        this.reviewError = '';
        this.reviewSuccess = true;
        this.triggerToast('Review submitted successfully!');
        
        setTimeout(() => {
          this.reviewSuccess = false;
        }, 5000);
      },
      checkoutOpen: false,
      checkoutSuccess: false,
      checkoutSubmitting: false,
      checkoutEmail: '',
      checkoutFirstName: '',
      checkoutLastName: '',
      checkoutAddress: '',
      checkoutApartment: '',
      checkoutCity: 'Lahore',
      checkoutPostalCode: '',
      checkoutProvince: 'Punjab',
      checkoutPhone: '',
      checkoutErrors: {},
      validateCheckout() {
        this.checkoutErrors = {};
        if (!this.checkoutEmail.trim()) {
          this.checkoutErrors.email = 'Email address is required';
        } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(this.checkoutEmail.trim())) {
          this.checkoutErrors.email = 'Enter a valid email address';
        }
        if (!this.checkoutFirstName.trim()) {
          this.checkoutErrors.firstName = 'First name is required';
        }
        if (!this.checkoutLastName.trim()) {
          this.checkoutErrors.lastName = 'Last name is required';
        }
        if (!this.checkoutAddress.trim()) {
          this.checkoutErrors.address = 'Street address is required';
        }
        if (!this.checkoutCity.trim()) {
          this.checkoutErrors.city = 'City is required';
        }
        if (!this.checkoutPostalCode.trim()) {
          this.checkoutErrors.postalCode = 'Postal code is required';
        } else if (this.checkoutPostalCode.trim().length < 4) {
          this.checkoutErrors.postalCode = 'Enter standard 4 or 5 digit postal code';
        }
        if (!this.checkoutProvince) {
          this.checkoutErrors.province = 'Province is required';
        }
        if (!this.checkoutPhone.trim()) {
          this.checkoutErrors.phone = 'Phone number is required';
        } else if (!/^((\+92|0|92)[3][0-9]{9})$/.test(this.checkoutPhone.replace(/[\s-]/g, ''))) {
          this.checkoutErrors.phone = 'Enter valid Pakistani mobile number (e.g. 03001234567)';
        }
        return Object.keys(this.checkoutErrors).length === 0;
      },
      submitCheckout() {
        if (!this.validateCheckout()) return;
        this.checkoutSubmitting = true;
        setTimeout(() => {
          this.checkoutSubmitting = false;
          this.checkoutSuccess = true;
          this.triggerToast('Order placed successfully! 🚀');
        }, 1200);
      }
    }"
    class="bg-[#090f19] border border-gray-800/80 rounded-3xl p-6 md:p-10 shadow-xl relative overflow-hidden"
  >
    <!-- Glow halo behind -->
    <div class="absolute top-0 right-0 w-96 h-96 rounded-full bg-[#7c3aed]/5 filter blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 rounded-full bg-[#00e5ff]/5 filter blur-3xl pointer-events-none"></div>

    <!-- Top Product Detail layout Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 items-start relative z-10">
      
      <!-- Left Column: Image Container / Slider -->
      <div class="lg:col-span-5 flex flex-col gap-4">
        <div class="relative aspect-square rounded-2xl bg-gradient-to-br from-[#0c1421] to-[#121d2e] border border-gray-800/80 flex items-center justify-center overflow-hidden shadow-inner group">
          <img
            :src="images[activeImage]"
            alt="{{ product.title | escape }}"
            class="w-full h-full object-cover relative z-10 select-none pointer-events-none"
          >

          <span class="absolute top-4 left-4 bg-rose-500/10 text-rose-450 border border-rose-500/25 text-xs font-bold px-3 py-1.5 rounded-full z-20">
            DISPATCH ACTIVE
          </span>

          <!-- Left & Right Slider Edge Nav Buttons -->
          <template x-if="images.length > 1">
            <div>
              <button
                @click="activeImage = (activeImage - 1 + images.length) % images.length"
                class="absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 flex items-center justify-center rounded-full bg-slate-900/70 backdrop-blur-sm border border-gray-850 hover:border-cyan-400 text-white cursor-pointer z-20 hover:bg-[#00e5ff]/20 hover:text-[#00e5ff] transition-all animate-fade"
                aria-label="Previous Image"
              >
                ‹
              </button>
              <button
                @click="activeImage = (activeImage + 1) % images.length"
                class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 flex items-center justify-center rounded-full bg-slate-900/70 backdrop-blur-sm border border-gray-850 hover:border-cyan-400 text-white cursor-pointer z-20 hover:bg-[#00e5ff]/20 hover:text-[#00e5ff] transition-all animate-fade"
                aria-label="Next Image"
              >
                ›
              </button>

              <!-- Index indicators overlay label -->
              <span class="absolute bottom-4 right-4 z-20 bg-slate-950/80 backdrop-blur-xs border border-gray-850 text-gray-300 px-3 py-1 rounded-lg text-[11px] font-mono select-none">
                <span class="text-[#00e5ff] font-bold" x-text="String(activeImage + 1).padStart(2, '0')">01</span> / <span x-text="String(images.length).padStart(2, '0')">01</span>
              </span>

              <!-- Dynamic Slider Active Highlight position line progress -->
              <div class="absolute bottom-0 left-0 right-0 h-1 bg-gray-950/40 z-20">
                <div 
                  class="h-full bg-gradient-to-r from-cyan-400 to-[#7c3aed] transition-all duration-300"
                  :style="'width: ' + (((activeImage + 1)/images.length)*100) + '%'"
                ></div>
              </div>
            </div>
          </template>
        </div>

        <!-- Micro Thumbnails Carousel Grid -->
        <template x-if="images.length > 1">
          <div class="grid grid-cols-5 gap-2.5">
            <template x-for="(img, idx) in images" :key="idx">
              <button
                @click="activeImage = idx"
                class="relative aspect-square rounded-xl bg-[#090f19] border overflow-hidden cursor-pointer transition-all"
                :class="idx === activeImage ? 'border-[#00e5ff] ring-1 ring-[#00e5ff]/35 opacity-100 shadow-md shadow-cyan-950/20 scale-102' : 'border-gray-850 opacity-55 hover:opacity-85'"
              >
                <img
                  :src="img"
                  alt="Thumbnail"
                  class="w-full h-full object-cover"
                >
              </button>
            </template>
          </div>
        </template>

        <!-- Safe Checked Stock banner -->
        <div class="p-4.5 bg-[#070b13] border border-gray-800/60 rounded-xl flex items-center gap-3.5">
          <div class="p-2.5 bg-cyan-950/40 text-[#00e5ff] rounded-lg">
            <i data-lucide="shield-check" class="w-5.5 h-5.5"></i>
          </div>
          <div>
            <h5 class="text-white text-xs font-semibold">100% Sealed & Checked Stock</h5>
            <p class="text-gray-400 text-[10px] mt-0.5">Tested before dispatch. 7 days replacement guarantee apply.</p>
          </div>
        </div>
      </div>

      <!-- Right Column: Descriptions & Actions -->
      <div class="lg:col-span-7 flex flex-col">
        <span class="text-[#00e5ff] text-xs font-extrabold tracking-widest uppercase">
          {{ product.vendor | default: 'TECHZONE DIRECT IMPORTS' }}
        </span>
        <h1 class="font-display font-black text-3xl sm:text-4xl text-white mt-1 leading-tight tracking-tight shadow-sm">
          {{ product.title | default: 'AirPods Pro 2 Premium ANC Copy' }}
        </h1>

        <!-- Rating review totals summary -->
        <div class="flex items-center gap-2 mt-4 select-none flex-wrap">
          <div class="flex text-amber-400 text-sm">
            ★★★★★
          </div>
          <span class="text-amber-400 font-bold font-mono text-xs">5.0</span>
          <span class="text-gray-400 border-l border-gray-800 pl-2 text-xs">
            Verified Customers (100% positive reviews)
          </span>
          <span class="text-emerald-400 text-[10px] font-mono font-bold px-2.5 py-1 rounded bg-emerald-500/10 border border-emerald-500/20 ml-auto select-none">
            VERIFIED IN LAHORE WAREHOUSE
          </span>
        </div>

        <p class="text-gray-300 text-sm md:text-base mt-6 leading-relaxed bg-[#0d1522]/30 border border-gray-800/30 p-5 rounded-2xl">
          {{ product.description | default: 'Direct custom copy manufactured globally. Features pure noise reduction filter layers, dynamic sound EQ, extra silicon ears comfort drops inside box, and lightning speed backup capacity!' }}
        </p>

        <!-- Pricing with savings calculator -->
        <div class="bg-[#05090f] border border-gray-800/60 p-6 rounded-2xl mt-6 flex items-center justify-between gap-4 flex-wrap">
          <div class="flex flex-col">
            <span class="text-gray-500 text-[9px] font-semibold tracking-wider uppercase">DELIVERY CHARGES COMPLETE FREE (COD ON DELIVERY)</span>
            <div class="flex items-baseline gap-3 mt-1.5">
              <span class="text-3xl sm:text-4xl font-black text-[#00e5ff] tracking-tight">
                {{ product.price | money | default: 'Rs. 2,499' }}
              </span>
              {%- if product.compare_at_price > product.price -%}
                <span class="text-xs sm:text-sm font-mono line-through text-gray-500">
                  {{ product.compare_at_price | money }}
                </span>
              {%- endif -%}
            </div>
          </div>

          <div class="bg-[#7c3aed]/10 text-violet-400 border border-[#7c3aed]/20 px-4.5 py-2.5 rounded-xl text-center flex flex-col justify-center select-none">
            <span class="text-[9px] font-bold tracking-wider uppercase">SPECIAL SAVE</span>
            <span class="text-lg font-black leading-tight">UP TO 50% OFF</span>
          </div>
        </div>

        <!-- CTA Checkout Actions -->
        <div class="flex flex-wrap gap-4 mt-6">
          <button
            @click="checkoutOpen = true"
            class="flex-1 min-w-[200px] bg-gradient-to-r from-[#00e5ff] to-[#7c3aed] hover:brightness-110 text-white font-black text-sm py-4.5 rounded-xl flex items-center justify-center gap-2 transition-all shadow-lg active:scale-98 cursor-pointer select-none"
          >
            Buy It Now
          </button>
          
          <button
            @click="cartCount++; triggerToast('Product added to checkout cart!')"
            class="bg-[#05090f] border border-gray-800 hover:border-gray-600 hover:bg-[#0c1421] text-white font-bold text-sm py-4.5 px-6 rounded-xl flex items-center justify-center gap-2.5 transition-all active:scale-98 cursor-pointer select-none"
          >
            <i data-lucide="shopping-cart" class="w-4.5 h-4.5 text-[#00e5ff]"></i>
            Cart me Dalein
          </button>
        </div>

      </div>
    </div>

    <!-- Specifications features grid -->
    <div class="mt-12 border-t border-gray-800/65 pt-9">
      <h3 class="font-display font-extrabold text-xl text-white mb-5 flex items-center gap-2 select-none">
        <span class="w-1.5 h-5 bg-[#00e5ff] rounded-full"></span>
        Device Features & Specifications
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <div class="bg-[#05090f] border border-gray-850 p-4.5 rounded-xl">
          <span class="text-[#00e5ff] uppercase text-[9px] font-extrabold tracking-widest block select-none">BATTERY LIFE</span>
          <p class="text-gray-200 text-xs md:text-sm font-medium mt-1">Up to 36 hours total play backup</p>
        </div>
        <div class="bg-[#05090f] border border-gray-850 p-4.5 rounded-xl">
          <span class="text-[#00e5ff] uppercase text-[9px] font-extrabold tracking-widest block select-none">CONNECTIVITY</span>
          <p class="text-gray-200 text-xs md:text-sm font-medium mt-1">Bluetooth 5.3 instant autosync</p>
        </div>
        <div class="bg-[#05090f] border border-gray-850 p-4.5 rounded-xl">
          <span class="text-[#00e5ff] uppercase text-[9px] font-extrabold tracking-widest block select-none">SOUND RANGE</span>
          <p class="text-gray-200 text-xs md:text-sm font-medium mt-1">HIFI Sound with 3D Spatial ANC active</p>
        </div>
      </div>
    </div>

    <!-- Ratings Summary Panel & Pakistan customer reviews -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 mt-12 border-t border-gray-800/65 pt-9 relative">
      
      <!-- Review Submit Form -->
      <div class="lg:col-span-4 flex flex-col gap-6">
        <div class="bg-[#05090f] border border-gray-800/40 p-6 rounded-2xl select-none">
          <h4 class="font-display font-extrabold text-white text-base">Ratings Summary</h4>
          <div class="flex items-baseline gap-2 mt-4">
            <span class="text-4xl font-black text-white font-mono">5.0</span>
            <span class="text-gray-500 font-mono text-sm">/ 5.0</span>
          </div>
          <div class="text-amber-400 mt-1">★★★★★</div>
          <span class="text-gray-500 text-[10px] block mt-1.5 leading-relaxed">Calculated based on verified countrywide orders delivered.</span>
        </div>

        <div class="bg-[#05090f] border border-gray-800/40 p-6 rounded-2xl">
          <h4 class="font-display font-extrabold text-white text-sm uppercase tracking-wider mb-1 flex items-center gap-1.5 select-none">
            <i data-lucide="plus" class="w-4 h-4 text-[#00e5ff]"></i>
            Write a verified Review
          </h4>
          <p class="text-gray-400 text-[11px] mb-4.5 select-none">Apna feedback share karein. It helps other shoppers make decisions!</p>

          <form @submit.prevent="submitReview()" class="space-y-3.5">
            <template x-if="reviewSuccess">
              <div class="p-3 bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold rounded-xl flex items-center gap-2">
                <i data-lucide="check-circle" class="w-4.5 h-4.5 shrink-0"></i>
                <span>Review added! Thank you for the verified drops insight.</span>
              </div>
            </template>

            <template x-if="reviewError">
              <div class="p-3 bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs font-semibold rounded-xl flex items-center gap-2">
                <i data-lucide="alert-circle" class="w-4.5 h-4.5 shrink-0"></i>
                <span x-text="reviewError"></span>
              </div>
            </template>

            <div>
              <label class="block text-[11px] font-mono text-gray-400 uppercase mb-1">Your Name *</label>
              <input
                type="text"
                x-model="newReviewName"
                placeholder="Usman, Sarah, Ali..."
                class="w-full bg-[#0c1421]/60 border border-gray-850 hover:border-gray-800 focus:border-[#00e5ff] text-white text-xs px-3.5 py-2.5 rounded-xl outline-none placeholder-gray-500"
              />
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-[11px] font-mono text-gray-400 uppercase mb-1">City *</label>
                <select
                  x-model="newReviewCity"
                  class="w-full bg-[#0c1421]/60 border border-gray-850 hover:border-gray-800 focus:border-[#00e5ff] text-white text-xs px-3.5 py-2.5 rounded-xl outline-none"
                >
                  <option value="Lahore" class="bg-[#090f19]">Lahore</option>
                  <option value="Karachi" class="bg-[#090f19]">Karachi</option>
                  <option value="Islamabad" class="bg-[#090f19]">Islamabad</option>
                  <option value="Rawalpindi" class="bg-[#090f19]">Rawalpindi</option>
                  <option value="Faisalabad" class="bg-[#090f19]">Faisalabad</option>
                </select>
              </div>

              <div>
                <label class="block text-[11px] font-mono text-gray-400 uppercase mb-1">Rating *</label>
                <select
                  x-model="newReviewRating"
                  class="w-full bg-[#0c1421]/60 border border-gray-850 hover:border-gray-800 focus:border-[#00e5ff] text-white text-xs px-3.5 py-2.5 rounded-xl outline-none text-amber-400 font-semibold"
                >
                  <option value="5" class="bg-[#090f19]">5 Stars (Perfect)</option>
                  <option value="4" class="bg-[#090f19]">4 Stars (Very Good)</option>
                  <option value="3" class="bg-[#090f19]">3 Stars (Good)</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-[11px] font-mono text-gray-400 uppercase mb-1">Review Details *</label>
              <textarea
                x-model="newReviewText"
                placeholder="Bhai iski deep bass aur battery kamaal hai... (Urdu/English compatible)"
                rows="3"
                class="w-full bg-[#0c1421]/60 border border-gray-850 hover:border-gray-800 focus:border-[#00e5ff] text-white text-xs px-3.5 py-2.5 rounded-xl outline-none placeholder-gray-500 resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full bg-gradient-to-r from-cyan-500/30 to-[#7c3aed]/30 hover:from-cyan-500/40 hover:to-[#7c3aed]/40 border border-cyan-500/30 text-white font-extrabold text-xs py-2.5 rounded-xl cursor-pointer"
            >
              Publish Verified Review
            </button>
          </form>
        </div>
      </div>

      <!-- Active Client Review Container -->
      <div class="lg:col-span-8 flex flex-col">
        <h4 class="font-display font-extrabold text-white text-lg mb-5 flex items-center gap-2 select-none">
          <i data-lucide="message-square" class="w-5 h-5 text-[#00e5ff]"></i>
          Customer Feedbacks
        </h4>
        <div class="space-y-4 max-h-[640px] overflow-y-auto pr-2">
          
          <template x-for="rev in reviews" :key="rev.id">
            <div class="bg-[#05090f]/50 border border-gray-850 p-5 rounded-2xl flex flex-col gap-3.5 hover:border-gray-800 transition-colors">
              <div class="flex items-start justify-between flex-wrap gap-2">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#00e5ff]/20 to-[#7c3aed]/20 text-[#00e5ff] border border-[#00e5ff]/10 flex items-center justify-center text-xs font-bold font-mono uppercase" x-text="rev.name.split(' ').map(n=>n[0]).join('')">
                    UA
                  </div>
                  <div>
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="text-white text-sm font-semibold" x-text="rev.name">Usman Ali</span>
                      <span class="text-cyan-400 text-[10px] font-bold font-mono" x-text="'('+rev.city+')'">(Lahore)</span>
                    </div>
                    <span class="text-emerald-400 text-[10px] font-semibold flex items-center gap-1 mt-0.5 select-none">
                      <span>✅ Order Verified (COD Complete)</span>
                    </span>
                  </div>
                </div>

                <div class="flex flex-col items-end gap-1">
                  <div class="text-amber-400 text-xs">★★★★★</div>
                  <span class="text-[10px] text-gray-500 font-mono" x-text="rev.date">2026-06-02</span>
                </div>
              </div>

              <p class="text-gray-200 text-sm italic leading-relaxed pl-1" x-text="'&ldquo;' + rev.text + '&rdquo;'">
                "Bhai sound quality aur heavy bass bilkul original jesi hai..."
              </p>
            </div>
          </template>

        </div>
      </div>
    </div>

    <!-- Premium Alpine-powered Cash on Delivery (COD) Checkout Modal -->
    <template x-if="checkoutOpen">
      <div 
        class="fixed inset-0 z-50 overflow-y-auto bg-black/75 flex items-center justify-center p-4 text-slate-800" 
        id="shopify-checkout-modal-overlay"
        @keydown.escape.window="checkoutOpen = false"
      >
        <div 
          class="relative w-full max-w-[1100px] bg-white rounded-2xl shadow-2xl overflow-hidden flex flex-col md:flex-row h-[90vh] md:h-[85vh] animate-fade"
          @click.away="checkoutOpen = false"
        >
          <!-- Close Button -->
          <button
            @click="checkoutOpen = false"
            class="absolute top-4 right-4 z-35 p-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 transition-colors cursor-pointer"
            aria-label="Close Checkout"
          >
            <i data-lucide="x" class="w-5 h-5"></i>
          </button>

          <!-- Left Side: Shopify Checkout Form -->
          <div class="w-full md:w-[60%] p-6 md:p-8 overflow-y-auto h-full bg-white flex flex-col justify-between">
            <div class="mb-5 flex items-center gap-1.5">
              <span class="font-extrabold text-lg text-slate-900 tracking-tight">TechZone</span>
              <span class="text-[10px] bg-slate-900 text-white font-bold px-1 py-0.5 rounded uppercase select-none">.pk</span>
            </div>

            <!-- Success screen -->
            <template x-if="checkoutSuccess">
              <div class="flex flex-col items-center justify-center py-6 text-center flex-1 gap-4">
                <div class="w-16 h-16 rounded-full bg-emerald-100 border border-emerald-300 text-emerald-600 flex items-center justify-center mb-1 shadow">
                  <i data-lucide="check" class="w-8 h-8"></i>
                </div>
                <p class="text-xs text-blue-600 font-bold uppercase tracking-widest font-mono">Order Thank you!</p>
                <h3 class="font-display font-black text-2.5xl text-slate-900 tracking-tight">Order Confirmed!</h3>
                <p class="text-slate-650 text-[14px] leading-relaxed max-w-sm px-2">
                  Thank you for shopping with <strong class="text-slate-900">TechZone.pk</strong>. <br />
                  Our team in Lahore will contact you shortly on WhatsApp/Call to verify your COD shipment details.
                </p>

                <div class="bg-slate-50 p-5 rounded-xl text-left w-full max-w-md mt-4 space-y-3 text-slate-700 border border-slate-200">
                  <div>
                    <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Ship To:</span>
                    <span class="text-slate-900 text-[13px] font-bold block mt-0.5" x-text="checkoutFirstName + ' ' + checkoutLastName"></span>
                  </div>
                  <div>
                    <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Phone Number / Contact:</span>
                    <span class="text-slate-700 text-[13px] block mt-0.5" x-text="checkoutPhone"></span>
                  </div>
                  <div>
                    <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider block">Address of Delivery:</span>
                    <span class="text-slate-700 text-[13px] block mt-0.5" x-text="checkoutAddress + (checkoutApartment ? ' (' + checkoutApartment + ')' : '')"></span>
                    <span class="text-slate-700 text-[13px] font-semibold block mt-0.5" x-text="checkoutCity + ', ' + checkoutProvince"></span>
                  </div>
                  <div class="border-t border-slate-250 pt-3 flex justify-between text-xs font-mono font-bold text-slate-400">
                    <span>PAYMENT MODE:</span>
                    <span class="text-slate-900 font-bold">CASH ON DELIVERY (COD)</span>
                  </div>
                </div>

                <button
                  @click="checkoutOpen = false; checkoutSuccess = false"
                  class="mt-6 w-full max-w-md bg-[#0c65e6] hover:bg-[#0b5cd1] text-white font-semibold text-[15px] py-4 rounded-lg transition-all duration-150 flex items-center justify-center gap-2 cursor-pointer shadow"
                >
                  Continue Shopping
                </button>
              </div>
            </template>

            <!-- Checkout Form screen -->
            <template x-if="!checkoutSuccess">
              <form @submit.prevent="submitCheckout()" class="space-y-6">
                
                <!-- Contact Section -->
                <div>
                  <div class="flex justify-between items-center mb-2">
                    <h3 class="text-[16px] font-semibold text-slate-950">Contact</h3>
                    <span class="text-xs text-slate-550 underline cursor-pointer hover:text-slate-900">Sign in</span>
                  </div>
                  
                  <div class="relative">
                    <input
                      type="email"
                      x-model="checkoutEmail"
                      placeholder="Email"
                      class="w-full border rounded-lg px-4 py-3 text-[14px] text-slate-800 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all placeholder:text-slate-400"
                      :class="checkoutErrors.email ? 'border-red-500 bg-red-50/10' : 'border-slate-350 bg-white'"
                    />
                  </div>
                  <template x-if="checkoutErrors.email">
                    <p class="text-red-500 text-[11px] font-medium mt-1" x-text="checkoutErrors.email"></p>
                  </template>

                  <label class="flex items-center gap-2 mt-3 cursor-pointer select-none">
                    <input
                      type="checkbox"
                      checked
                      class="rounded border-slate-300 text-blue-600 focus:ring-blue-500 h-4.5 w-4.5"
                    />
                    <span class="text-[13px] text-slate-650 font-medium select-none">Email me with news and offers</span>
                  </label>
                </div>

                <!-- Payment Block -->
                <div>
                  <h3 class="text-[16px] font-semibold text-slate-950 mb-1.5">Payment</h3>
                  <p class="text-[12px] text-slate-550 mb-3">All transactions are secure and encrypted.</p>
                  
                  <div class="border border-blue-600 bg-blue-50/5 rounded-xl overflow-hidden">
                    <div class="p-3.5 bg-blue-50/20 border-b border-blue-100 flex items-center justify-between">
                      <div class="flex items-center gap-3">
                        <div class="h-5.5 w-5.5 rounded-full border-[5px] border-blue-600 bg-white"></div>
                        <span class="text-[14px] font-semibold text-slate-900">Cash on Delivery (COD)</span>
                      </div>
                    </div>
                    <div class="p-4 bg-slate-50 text-[13px] text-slate-650">
                      Pay when rider delivers the order on your doorstep.
                    </div>
                  </div>
                </div>

                <!-- Billing address -->
                <div>
                  <h3 class="text-[16px] font-semibold text-slate-950 mb-4">Billing address</h3>
                  
                  <div class="space-y-3">
                    <!-- Country -->
                    <div>
                      <label class="block text-[11px] font-medium text-slate-500 uppercase tracking-wider mb-1">Country/Region</label>
                      <select
                        disabled
                        class="w-full bg-slate-50 border border-slate-200 text-slate-700 rounded-lg px-3.5 py-3 text-[14px] outline-none cursor-not-allowed"
                      >
                        <option>Pakistan</option>
                      </select>
                    </div>

                    <!-- First / Last Name -->
                    <div class="grid grid-cols-2 gap-3">
                      <div>
                        <input
                          type="text"
                          x-model="checkoutFirstName"
                          placeholder="First name"
                          class="w-full border rounded-lg px-3.5 py-3 text-[14px] text-slate-800 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all placeholder:text-slate-400"
                          :class="checkoutErrors.firstName ? 'border-red-500' : 'border-slate-350'"
                        />
                        <template x-if="checkoutErrors.firstName">
                          <p class="text-red-500 text-[11px] font-medium mt-1" x-text="checkoutErrors.firstName"></p>
                        </template>
                      </div>
                      <div>
                        <input
                          type="text"
                          x-model="checkoutLastName"
                          placeholder="Last name"
                          class="w-full border rounded-lg px-3.5 py-3 text-[14px] text-slate-800 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all placeholder:text-slate-400"
                          :class="checkoutErrors.lastName ? 'border-red-500' : 'border-slate-350'"
                        />
                        <template x-if="checkoutErrors.lastName">
                          <p class="text-red-500 text-[11px] font-medium mt-1" x-text="checkoutErrors.lastName"></p>
                        </template>
                      </div>
                    </div>

                    <!-- Address -->
                    <div>
                      <input
                        type="text"
                        x-model="checkoutAddress"
                        placeholder="Address"
                        class="w-full border rounded-lg px-3.5 py-3 text-[14px] text-slate-800 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all placeholder:text-slate-400"
                        :class="checkoutErrors.address ? 'border-red-500' : 'border-slate-350'"
                      />
                      <template x-if="checkoutErrors.address">
                        <p class="text-red-500 text-[11px] font-medium mt-1" x-text="checkoutErrors.address"></p>
                      </template>
                    </div>

                    <!-- Apartment -->
                    <div>
                      <input
                        type="text"
                        x-model="checkoutApartment"
                        placeholder="Apartment, suite, etc. (optional)"
                        class="w-full border border-slate-350 rounded-lg px-3.5 py-3 text-[14px] text-slate-800 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all placeholder:text-slate-400"
                      />
                    </div>

                    <!-- City & Postal code (main compulsory items) -->
                    <div class="grid grid-cols-2 gap-3">
                      <div>
                        <select
                          x-model="checkoutCity"
                          class="w-full border border-slate-350 rounded-lg px-3.5 py-3 text-[14px] text-slate-800 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"
                        >
                          <option value="Lahore">Lahore</option>
                          <option value="Karachi">Karachi</option>
                          <option value="Islamabad">Islamabad</option>
                          <option value="Rawalpindi">Rawalpindi</option>
                          <option value="Faisalabad">Faisalabad</option>
                          <option value="Multan">Multan</option>
                          <option value="Peshawar">Peshawar</option>
                          <option value="Quetta">Quetta</option>
                          <option value="Sialkot">Sialkot</option>
                          <option value="Gujranwala">Gujranwala</option>
                          <option value="Hyderabad">Hyderabad</option>
                        </select>
                        <template x-if="checkoutErrors.city">
                          <p class="text-red-500 text-[11px] font-medium mt-1" x-text="checkoutErrors.city"></p>
                        </template>
                      </div>
                      <div>
                        <input
                          type="text"
                          x-model="checkoutPostalCode"
                          placeholder="Postal Code *"
                          class="w-full border rounded-lg px-3.5 py-3 text-[14px] text-slate-800 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all placeholder:text-slate-400"
                          :class="checkoutErrors.postalCode ? 'border-red-500' : 'border-slate-350'"
                        />
                        <template x-if="checkoutErrors.postalCode">
                          <p class="text-red-500 text-[11px] font-medium mt-1" x-text="checkoutErrors.postalCode"></p>
                        </template>
                      </div>
                    </div>

                    <!-- Province Selector (Compulsory as requested) -->
                    <div>
                      <label class="block text-[11px] font-medium text-slate-500 uppercase tracking-wider mb-1">Province *</label>
                      <select
                        x-model="checkoutProvince"
                        class="w-full border border-slate-350 rounded-lg px-3.5 py-3 text-[14px] text-slate-800 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"
                      >
                        <option value="Punjab">Punjab</option>
                        <option value="Sindh">Sindh</option>
                        <option value="Khyber Pakhtunkhwa">Khyber Pakhtunkhwa</option>
                        <option value="Balochistan">Balochistan</option>
                        <option value="Islamabad Capital Territory">Islamabad Capital Territory</option>
                        <option value="Azad Jammu & Kashmir">Azad Jammu & Kashmir</option>
                        <option value="Gilgit-Baltistan">Gilgit-Baltistan</option>
                      </select>
                      <template x-if="checkoutErrors.province">
                        <p class="text-red-500 text-[11px] font-medium mt-1" x-text="checkoutErrors.province"></p>
                      </template>
                    </div>

                    <!-- Phone Input (Compulsory as requested) -->
                    <div>
                      <input
                        type="tel"
                        x-model="checkoutPhone"
                        placeholder="Phone Number * (e.g. 03001234567)"
                        class="w-full border rounded-lg px-3.5 py-3 text-[14px] text-slate-800 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all placeholder:text-slate-400"
                        :class="checkoutErrors.phone ? 'border-red-500' : 'border-slate-350'"
                      />
                      <template x-if="checkoutErrors.phone">
                        <p class="text-red-500 text-[11px] font-medium mt-1" x-text="checkoutErrors.phone"></p>
                      </template>
                    </div>
                  </div>
                </div>

                <!-- Complete Order Buttons -->
                <div class="pt-4 border-t border-slate-100">
                  <button
                    type="submit"
                    :disabled="checkoutSubmitting"
                    class="w-full bg-[#0c65e6] hover:bg-[#0b5cd1] text-white font-semibold text-[15px] py-4 rounded-lg transition-all duration-150 flex items-center justify-center gap-2 cursor-pointer shadow-sm shadow-blue-200/50"
                  >
                    <span x-show="checkoutSubmitting" class="w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin"></span>
                    <span x-show="!checkoutSubmitting">Complete order</span>
                  </button>
                </div>

              </form>
            </template>
          </div>

          <!-- Right Side: Order Summary Panel -->
          <div class="w-full md:w-[40%] bg-slate-50 border-t md:border-t-0 md:border-l border-slate-100 p-6 md:p-8 flex flex-col justify-between overflow-y-auto h-full text-slate-700">
            <div>
              <h3 class="text-[15px] font-bold text-slate-500 tracking-wide mb-6 uppercase">Order summary</h3>
              
              <!-- Product Item Line -->
              <div class="flex gap-4 items-center justify-between pb-4 border-b border-slate-200/65">
                <div class="flex items-center gap-3.5">
                  <div class="relative w-15 h-15 bg-white border border-slate-200 rounded-xl flex items-center justify-center p-1">
                    <img
                      :src="images[0]"
                      alt="{{ product.title | escape }}"
                      class="w-full h-full object-contain rounded-lg"
                    />
                    <!-- Shopify Circular Quantity Badge -->
                    <span class="absolute -top-1.5 -right-1.5 h-5 w-5 bg-slate-800 text-white text-[11px] font-bold rounded-full flex items-center justify-center shadow">
                      1
                    </span>
                  </div>
                  <div>
                    <h4 class="text-[14px] font-bold text-slate-900 leading-tight">
                      {{ product.title }}
                    </h4>
                    <p class="text-[11px] text-slate-500 font-medium font-mono mt-0.5">Brand: TechZone</p>
                  </div>
                </div>
                <span class="text-[14px] font-semibold text-slate-850 font-mono">
                  {{ product.price | money }}
                </span>
              </div>

              <!-- Costs -->
              <div class="space-y-3.5 py-5 border-b border-slate-200/65 text-[13px] text-slate-600">
                <div class="flex justify-between">
                  <span>Subtotal</span>
                  <span class="font-mono text-slate-800 font-medium">{{ product.price | money }}</span>
                </div>
                <div class="flex justify-between items-center">
                  <span>Shipping</span>
                  <span class="text-[11px] font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full uppercase">Free</span>
                </div>
                <div class="flex justify-between">
                  <span>Taxes & Duties</span>
                  <span class="text-slate-400 italic text-[11px]">Included</span>
                </div>
              </div>
            </div>

            <!-- Total -->
            <div class="pt-5 flex items-center justify-between">
              <span class="text-[16px] font-bold text-slate-950">Total</span>
              <div class="flex items-baseline gap-1">
                <span class="text-[11px] text-slate-400 font-medium font-mono">PKR</span>
                <span class="text-[22px] font-black text-slate-950 font-mono tracking-tight">
                  {{ product.price | money_without_currency }}
                </span>
              </div>
            </div>

          </div>

        </div>
      </div>
    </template>

  </div>
</div>

{% schema %}
{
  "name": "Main Product Section",
  "settings": []
}
{% endschema %}
