<section 
  id="products-section"
  x-data="{ 
    selectedCategory: 'all',
    init() {
      // Re-initialize Lucide Icons when Alpine modifies categories if needed
      this.$watch('selectedCategory', () => {
        setTimeout(() => lucide.createIcons(), 50);
      });
    }
  }" 
  class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 border-t border-gray-900"
>
  <!-- Category Filter Selector Header Header -->
  <div class="flex flex-col md:flex-row items-center justify-between gap-6 mb-10">
    <div class="text-center md:text-left">
      <h2 class="font-display font-black text-2xl sm:text-3.5xl text-white uppercase tracking-tight flex items-center justify-center md:justify-start gap-2.5">
        <span class="w-1.5 h-6 bg-[#00e5ff] rounded-full inline-block"></span>
        DISCOUNTED PRODUCTS STORE
      </h2>
      <p class="text-gray-450 text-xs md:text-sm mt-1">Sasta aur High-Quality Gadget Drops direct from Lahore wholesale stock.</p>
    </div>

    <!-- Category selectors filter pill list -->
    <div class="flex flex-wrap items-center gap-2 bg-[#05090f]/70 border border-gray-850 p-1.5 rounded-2xl select-none">
      <button
        @click="selectedCategory = 'all'"
        :class="selectedCategory === 'all' ? 'bg-[#7c3aed] text-white' : 'text-gray-400 hover:text-white'"
        class="px-4.5 py-2.5 rounded-xl text-xs font-semibold tracking-wide transition-all uppercase cursor-pointer"
      >
        All Items
      </button>
      <button
        @click="selectedCategory = 'audio'"
        :class="selectedCategory === 'audio' ? 'bg-[#7c3aed] text-white' : 'text-gray-400 hover:text-white'"
        class="px-4.5 py-2.5 rounded-xl text-xs font-semibold tracking-wide transition-all uppercase cursor-pointer"
      >
        AirPods & Audio
      </button>
      <button
        @click="selectedCategory = 'wearables'"
        :class="selectedCategory === 'wearables' ? 'bg-[#7c3aed] text-white' : 'text-gray-400 hover:text-white'"
        class="px-4.5 py-2.5 rounded-xl text-xs font-semibold tracking-wide transition-all uppercase cursor-pointer"
      >
        Smartwatches
      </button>
      <button
        @click="selectedCategory = 'gaming'"
        :class="selectedCategory === 'gaming' ? 'bg-[#7c3aed] text-white' : 'text-gray-400 hover:text-white'"
        class="px-4.5 py-2.5 rounded-xl text-xs font-semibold tracking-wide transition-all uppercase cursor-pointer"
      >
        Gaming Access.
      </button>
    </div>
  </div>

  <!-- Product Catalog Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    
    <!-- Render shopify products or fallback premium custom products -->
    {%- if collections.all.products.size > 0 -%}
      {%- for product in collections.all.products -%}
        <!-- Dynamic Shopify card output customized to our high-contrast layout -->
        {%- render 'product-card', product: product -%}
      {%- endfor -%}
    {%- else -%}
      
      <!-- FALLBACK DEMO PRODUCT 1 -->
      <div 
        x-show="selectedCategory === 'all' || selectedCategory === 'audio'"
        class="bg-[#090f19] border border-gray-850/80 rounded-2xl p-4.5 hover:border-[#00e5ff]/50 hover:bg-[#0b1422]/40 transition-all duration-300 group flex flex-col justify-between"
      >
        <div>
          <!-- Thumbnail Visualizer -->
          <div class="aspect-square bg-slate-950 rounded-xl flex items-center justify-center mb-4 relative overflow-hidden border border-gray-850 select-none">
            <span class="text-7.5xl filter drop-shadow-[0_15px_15px_rgba(0,229,255,0.25)] select-none pointer-events-none group-hover:scale-105 transition-transform duration-300">🎧</span>
            <span class="absolute top-2.5 left-2.5 bg-rose-500/15 border border-rose-500/30 text-rose-400 text-[9px] font-bold tracking-wider px-2.5 py-1 rounded-md uppercase">
              Bestseller
            </span>
          </div>

          <span class="text-[#00e5ff] text-[9px] font-extrabold tracking-widest uppercase">AIRPODS COPY</span>
          <h4 class="text-white text-[15px] font-bold mt-1 line-clamp-1 group-hover:text-neonCyan transition-all">AirPods Pro 2 Master Copy</h4>
          
          <div class="flex items-center gap-1.5 mt-2 select-none">
            <div class="text-amber-400 text-xs">★★★★★</div>
            <span class="text-gray-500 text-[10px] font-mono">(112 reviews)</span>
          </div>
          
          <p class="text-gray-400 text-xs mt-2 line-clamp-2">Latest USB-C design with real ANC noise reduction and deep bass loops sound.</p>
        </div>

        <div>
          <div class="flex items-baseline gap-2 mt-4 pt-3.5 border-t border-gray-850/60 w-full">
            <span class="text-base font-extrabold text-[#00e5ff] font-mono">Rs. 2,499</span>
            <span class="text-xs text-gray-500 line-through font-mono">Rs. 5,000</span>
            <span class="text-[9px] font-bold text-violet-400 uppercase bg-violet-950/20 px-1.5 py-0.5 rounded border border-violet-500/10 ml-auto">-50%</span>
          </div>

          <!-- CTA Buttons -->
          <div class="grid grid-cols-2 gap-2 mt-4">
            <button 
              @click="cartCount++; triggerToast('AirPods Pro 2 added! (Rs. 2,499)')" 
              class="bg-slate-900 border border-gray-800 hover:border-gray-500 text-white font-semibold text-xs py-2 px-1 rounded-lg transition-all cursor-pointer select-none"
            >
              Add to Cart
            </button>
            <button 
              @click="triggerToast('Redirecting to fast Order Process...')" 
              class="bg-[#7c3aed] text-white font-bold text-xs py-2 px-1 rounded-lg hover:brightness-110 transition-all cursor-pointer select-none"
            >
              Order Now
            </button>
          </div>
        </div>
      </div>

      <!-- FALLBACK DEMO PRODUCT 2 -->
      <div 
        x-show="selectedCategory === 'all' || selectedCategory === 'wearables'"
        class="bg-[#090f19] border border-gray-850/80 rounded-2xl p-4.5 hover:border-[#00e5ff]/50 hover:bg-[#0b1422]/40 transition-all duration-300 group flex flex-col justify-between"
      >
        <div>
          <div class="aspect-square bg-slate-950 rounded-xl flex items-center justify-center mb-4 relative overflow-hidden border border-gray-850 select-none">
            <span class="text-7.5xl filter drop-shadow-[0_15px_15px_rgba(0,229,255,0.25)] select-none pointer-events-none group-hover:scale-105 transition-transform duration-300">⌚</span>
            <span class="absolute top-2.5 left-2.5 bg-[#7c3aed]/15 border border-[#7c3aed]/30 text-violet-400 text-[9px] font-bold tracking-wider px-2.5 py-1 rounded-md uppercase">
              Bumper Pack
            </span>
          </div>

          <span class="text-[#00e5ff] text-[9px] font-extrabold tracking-widest uppercase">Y60 ULTRA COLLECTION</span>
          <h4 class="text-white text-[15px] font-bold mt-1 line-clamp-1 group-hover:text-neonCyan transition-all">Y60 Ultra Smartwatch 7 in 1</h4>
          
          <div class="flex items-center gap-1.5 mt-2 select-none">
            <div class="text-amber-400 text-xs">★★★★☆</div>
            <span class="text-gray-500 text-[10px] font-mono">(89 reviews)</span>
          </div>
          
          <p class="text-gray-400 text-xs mt-2 line-clamp-2">Comes with 7 different fashion replacement straps inside package.</p>
        </div>

        <div>
          <div class="flex items-baseline gap-2 mt-4 pt-3.5 border-t border-gray-850/60 w-full">
            <span class="text-base font-extrabold text-[#00e5ff] font-mono">Rs. 3,499</span>
            <span class="text-xs text-gray-500 line-through font-mono">Rs. 7,000</span>
            <span class="text-[9px] font-bold text-violet-400 uppercase bg-violet-950/20 px-1.5 py-0.5 rounded border border-violet-500/10 ml-auto">-50%</span>
          </div>

          <div class="grid grid-cols-2 gap-2 mt-4">
            <button 
              @click="cartCount++; triggerToast('Y60 Ultra Smartwatch added! (Rs. 3,499)')" 
              class="bg-slate-900 border border-gray-800 hover:border-gray-500 text-white font-semibold text-xs py-2 px-1 rounded-lg transition-all cursor-pointer select-none"
            >
              Add to Cart
            </button>
            <button 
              @click="triggerToast('Redirecting to fast Order Process...')" 
              class="bg-[#7c3aed] text-white font-bold text-xs py-2 px-1 rounded-lg hover:brightness-110 transition-all cursor-pointer select-none"
            >
              Order Now
            </button>
          </div>
        </div>
      </div>

      <!-- FALLBACK DEMO PRODUCT 3 -->
      <div 
        x-show="selectedCategory === 'all' || selectedCategory === 'gaming'"
        class="bg-[#090f19] border border-gray-850/80 rounded-2xl p-4.5 hover:border-[#00e5ff]/50 hover:bg-[#0b1422]/40 transition-all duration-300 group flex flex-col justify-between"
      >
        <div>
          <div class="aspect-square bg-slate-950 rounded-xl flex items-center justify-center mb-4 relative overflow-hidden border border-gray-850 select-none">
            <span class="text-7.5xl filter drop-shadow-[0_15px_15px_rgba(0,229,255,0.25)] select-none pointer-events-none group-hover:scale-105 transition-transform duration-300">🎮</span>
            <span class="absolute top-2.5 left-2.5 bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-[9px] font-bold tracking-wider px-2.5 py-1 rounded-md uppercase">
              Low Latency
            </span>
          </div>

          <span class="text-[#00e5ff] text-[9px] font-extrabold tracking-widest uppercase">M90 HEADSET</span>
          <h4 class="text-white text-[15px] font-bold mt-1 line-clamp-1 group-hover:text-neonCyan transition-all">M90 Pro Quad Gaming Earbuds</h4>
          
          <div class="flex items-center gap-1.5 mt-2 select-none">
            <div class="text-amber-400 text-xs">★★★★★</div>
            <span class="text-gray-500 text-[10px] font-mono">(173 reviews)</span>
          </div>
          
          <p class="text-gray-400 text-xs mt-2 line-clamp-2">Comes with power-bank charging capacity + dynamic LED levels meter.</p>
        </div>

        <div>
          <div class="flex items-baseline gap-2 mt-4 pt-3.5 border-t border-gray-850/60 w-full">
            <span class="text-base font-extrabold text-[#00e5ff] font-mono">Rs. 1,899</span>
            <span class="text-xs text-gray-500 line-through font-mono">Rs. 3,800</span>
            <span class="text-[9px] font-bold text-violet-400 uppercase bg-violet-950/20 px-1.5 py-0.5 rounded border border-violet-500/10 ml-auto">-50%</span>
          </div>

          <div class="grid grid-cols-2 gap-2 mt-4">
            <button 
              @click="cartCount++; triggerToast('M90 Pro Earbuds added! (Rs. 1,899)')" 
              class="bg-slate-900 border border-gray-800 hover:border-gray-500 text-white font-semibold text-xs py-2 px-1 rounded-lg transition-all cursor-pointer select-none"
            >
              Add to Cart
            </button>
            <button 
              @click="triggerToast('Redirecting to fast Order Process...')" 
              class="bg-[#7c3aed] text-white font-bold text-xs py-2 px-1 rounded-lg hover:brightness-110 transition-all cursor-pointer select-none"
            >
              Order Now
            </button>
          </div>
        </div>
      </div>

      <!-- FALLBACK DEMO PRODUCT 4 -->
      <div 
        x-show="selectedCategory === 'all' || selectedCategory === 'wearables'"
        class="bg-[#090f19] border border-gray-850/80 rounded-2xl p-4.5 hover:border-[#00e5ff]/50 hover:bg-[#0b1422]/40 transition-all duration-300 group flex flex-col justify-between"
      >
        <div>
          <div class="aspect-square bg-slate-950 rounded-xl flex items-center justify-center mb-4 relative overflow-hidden border border-gray-850 select-none">
            <span class="text-7.5xl filter drop-shadow-[0_15px_15px_rgba(0,229,255,0.25)] select-none pointer-events-none group-hover:scale-105 transition-transform duration-300">⚙️</span>
            <span class="absolute top-2.5 left-2.5 bg-rose-500/15 border border-rose-500/30 text-rose-400 text-[9px] font-bold tracking-wider px-2.5 py-1 rounded-md uppercase">
              Full Screen
            </span>
          </div>

          <span class="text-[#00e5ff] text-[9px] font-extrabold tracking-widest uppercase">S10 MAX EDITION</span>
          <h4 class="text-white text-[15px] font-bold mt-1 line-clamp-1 group-hover:text-neonCyan transition-all">S10 Ultra 2 Max Smartwatch</h4>
          
          <div class="flex items-center gap-1.5 mt-2 select-none">
            <div class="text-amber-400 text-xs">★★★★☆</div>
            <span class="text-gray-500 text-[10px] font-mono">(43 reviews)</span>
          </div>
          
          <p class="text-gray-400 text-xs mt-2 line-clamp-2">Pure metal design with heavy backup battery + double action dialer.</p>
        </div>

        <div>
          <div class="flex items-baseline gap-2 mt-4 pt-3.5 border-t border-gray-850/60 w-full">
            <span class="text-base font-extrabold text-[#00e5ff] font-mono">Rs. 4,200</span>
            <span class="text-xs text-gray-500 line-through font-mono">Rs. 8,000</span>
            <span class="text-[9px] font-bold text-violet-400 uppercase bg-violet-950/20 px-1.5 py-0.5 rounded border border-violet-500/10 ml-auto">-47%</span>
          </div>

          <div class="grid grid-cols-2 gap-2 mt-4">
            <button 
              @click="cartCount++; triggerToast('S10 Ultra 2 Max added! (Rs. 4,200)')" 
              class="bg-slate-900 border border-gray-800 hover:border-gray-500 text-white font-semibold text-xs py-2 px-1 rounded-lg transition-all cursor-pointer select-none"
            >
              Add to Cart
            </button>
            <button 
              @click="triggerToast('Redirecting to fast Order Process...')" 
              class="bg-[#7c3aed] text-white font-bold text-xs py-2 px-1 rounded-lg hover:brightness-110 transition-all cursor-pointer select-none"
            >
              Order Now
            </button>
          </div>
        </div>
      </div>

    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "TechZone Catalog",
  "settings": [],
  "presets": [
    {
      "name": "TechZone Catalog"
    }
  ]
}
{% endschema %}
