<header 
  class="sticky top-0 z-40 bg-[#080c10]/85 backdrop-blur-md border-b border-gray-800/60 transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Header Logo Brand -->
    <a href="/" class="flex items-center gap-1.5 focus:outline-none">
      <span class="font-display font-black text-2xl tracking-tight bg-gradient-to-r from-[#00e5ff] to-[#7c3aed] bg-clip-text text-transparent hover:brightness-110 transition-all">
        TechZone
      </span>
      <span class="text-white text-[9px] font-mono font-bold uppercase tracking-wider bg-[#16253b]/55 px-2 py-0.5 rounded border border-gray-850 select-none">
        PK
      </span>
    </a>

    <!-- Large Screen Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium tracking-wide">
      <a href="/" class="text-gray-300 hover:text-[#00e5ff] transition-colors">Home</a>
      <a href="#products-section" class="text-gray-300 hover:text-[#00e5ff] transition-colors">Catalog</a>
      <a href="#trust-badges" class="text-gray-300 hover:text-[#00e5ff] transition-colors">COD Guarantee</a>
      <a href="#newsletter-section" class="text-gray-300 hover:text-[#00e5ff] transition-colors">Drops Alert</a>
    </nav>

    <!-- Shopping Actions -->
    <div class="flex items-center gap-3.5 select-none">
      <!-- Shopping Cart Dynamic Button -->
      <button
        @click="toggleCart()"
        class="relative p-2.5 bg-[#0d1522] border border-gray-800/80 hover:border-[#00e5ff] rounded-xl text-gray-400 hover:text-white transition-all cursor-pointer flex items-center gap-2"
        aria-label="Toggle Shopping Cart Box"
      >
        <i data-lucide="shopping-cart" class="w-4.5 h-4.5 text-[#00e5ff]"></i>
        <span class="text-[10px] sm:text-xs font-mono font-bold pr-0.5" x-text="cartCount">0</span>
      </button>

      <!-- Support button contact -->
      <a
        href="https://wa.me/{{ settings.social_whatsapp }}"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 px-3.5 py-2.5 bg-[#072a19]/40 border border-emerald-500/20 hover:border-emerald-500 text-emerald-400 rounded-xl text-xs font-semibold cursor-pointer select-none transition-all"
      >
        <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-ping"></span>
        Order help (WhatsApp)
      </a>
    </div>
  </div>

  <!-- INTERACTIVE ALPINE CART DRAWER PORTAL -->
  <template x-if="cartOpen">
    <div class="fixed inset-0 z-50 overflow-hidden">
      <!-- Overlay backdrop -->
      <div 
        @click="toggleCart()"
        class="absolute inset-0 bg-black/75 backdrop-blur-sm transition-opacity"
      ></div>

      <div class="absolute inset-y-0 right-0 max-w-md w-full flex">
        <div 
          x-transition:enter="transform transition ease-in-out duration-300"
          x-transition:enter-start="translate-x-full"
          x-transition:enter-end="translate-x-0"
          x-transition:leave="transform transition ease-in-out duration-300"
          x-transition:leave-start="translate-x-0"
          x-transition:leave-end="translate-x-full"
          class="bg-[#080d14] border-l border-gray-800/80 w-full flex flex-col justify-between"
        >
          <!-- Drawer Header -->
          <div class="p-5 border-b border-gray-800/60 flex items-center justify-between">
            <h3 class="font-display font-bold text-lg text-white flex items-center gap-2">
              <i data-lucide="shopping-bag" class="w-5 h-5 text-[#00e5ff]"></i>
              Apka Shopping Cart
            </h3>
            <button 
              @click="toggleCart()"
              class="p-2 hover:bg-white/5 border border-gray-800 rounded-lg text-gray-400 hover:text-white transition-all cursor-pointer"
            >
              <i data-lucide="x" class="w-4 h-4"></i>
            </button>
          </div>

          <!-- Drawer empty state as fallback / list goes here -->
          <div class="flex-1 overflow-y-auto p-5 flex flex-col items-center justify-center text-center gap-3">
            <div class="w-16 h-16 rounded-full bg-slate-900 border border-gray-800 flex items-center justify-center text-gray-500">
              <i data-lucide="shopping-cart" class="w-7 h-7"></i>
            </div>
            <p class="text-white text-sm font-semibold">Apka Cart Abhi Khali Hai!</p>
            <p class="text-gray-400 text-xs max-w-xs leading-relaxed">
              Shopify product catalogue se premium AirPods Pro 2, smartwatch aur gaming premium items cart me dakhil karein!
            </p>
            <button 
              @click="toggleCart()" 
              class="mt-3 bg-gradient-to-r from-[#00e5ff] to-[#7c3aed] text-white text-xs font-display font-bold px-5 py-2.5 rounded-xl transition-all"
            >
              Shopping Jari Rakhein
            </button>
          </div>

          <!-- Drawer COD Footer banner -->
          <div class="p-5 border-t border-gray-800/80 bg-[#040810]/80">
            <div class="flex items-center justify-between text-xs text-gray-400 mb-4">
              <span>Delivery Charges</span>
              <span class="text-emerald-400 font-bold uppercase font-mono">100% FREE (Across Pakistan)</span>
            </div>
            <div class="p-4 bg-[#0a1b14]/50 border border-emerald-500/20 rounded-xl mb-4 flex items-center gap-2.5">
              <i data-lucide="check-circle" class="w-5 h-5 text-emerald-400 shrink-0"></i>
              <span class="text-gray-300 text-[10px] md:text-xs leading-normal">
                Apko delivery waqt paise ada krne hain <strong>(Cash on Delivery)</strong>. Koi advance fees nahi!
              </span>
            </div>
          </div>

        </div>
      </div>
    </div>
  </template>
</header>

{% schema %}
{
  "name": "TechZone Header",
  "settings": []
}
{% endschema %}
